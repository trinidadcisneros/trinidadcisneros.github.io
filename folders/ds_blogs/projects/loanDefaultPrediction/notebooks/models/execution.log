# Analyze leaf nodes
tree = tree_model.tree_
leaf_mask = tree.children_left == _tree.TREE_LEAF

leaf_data = []
for i in range(tree.node_count):
    if tree.children_left[i] == _tree.TREE_LEAF:
        values = tree.value[i][0]
        n0, n1 = int(values[0]), int(values[1])
        total = n0 + n1
        leaf_data.append({
            "leaf_id": i,
            "n_samples": total,
            "n_good": n0,
            "n_default": n1,
            "default_rate": n1 / total if total > 0 else 0,
            "prediction": "Default" if n1 / total >= 0.5 else "Good",
        })

df_leaves = pd.DataFrame(leaf_data).sort_values("default_rate", ascending=False)

print(f"Number of leaves: {len(df_leaves)}")
print(f"Leaves predicting Default: {(df_leaves['prediction'] == 'Default').sum()}")
print(f"Leaves predicting Good: {(df_leaves['prediction'] == 'Good').sum()}")
print(f"\nLeaf size range: {df_leaves['n_samples'].min()} to {df_leaves['n_samples'].max()}")
print(f"Default rate range: {df_leaves['default_rate'].min():.2%} to {df_leaves['default_rate'].max():.2%}")

# Leaf default rate distribution
fig_leaf = go.Figure()
fig_leaf.add_trace(go.Bar(
    x=list(range(len(df_leaves))),
    y=df_leaves["default_rate"].values,
    marker_color=[COLORS["red"] if p >= 0.5 else COLORS["accent"] for p in df_leaves["default_rate"]],
    text=[f"n={r['n_samples']}" for _, r in df_leaves.iterrows()],
    textposition="outside",
    textfont=dict(size=8),
))
fig_leaf.add_hline(y=0.5, line_dash="dash", line_color=COLORS["gray"],
                   annotation_text="Decision boundary (0.5)")
fig_leaf.add_hline(y=y_train.mean(), line_dash="dot", line_color=COLORS["orange"],
                   annotation_text=f"Base rate ({y_train.mean():.1%})")
fig_leaf.update_layout(
    title="Leaf Node Default Rates (sorted descending)",
    xaxis_title="Leaf Node (ranked)",
    yaxis_title="Default Rate in Leaf",
    height=450, width=700,
)
fig_leaf.show()
save_chart(fig_leaf, MODEL_SLUG, "leaf_analysis")
