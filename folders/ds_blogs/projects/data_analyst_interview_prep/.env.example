# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=your-key-here

# Postgres sandbox (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=practice
POSTGRES_PASSWORD=practice
POSTGRES_DB=practice

# MySQL sandbox (matches docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=practice
MYSQL_PASSWORD=practice
MYSQL_DB=practice
