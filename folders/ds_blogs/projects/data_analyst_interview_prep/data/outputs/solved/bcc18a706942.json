  "user_solution": "/* notes */\n\nSelect \n    patient_id,\n    visit_date,\n    visit_type,\n    visit_date - LAG(visit_date) OVER (PARTITION BY patient_id ORDER BY visit_date) AS days_since_last_visit\nFROM patient_visits\nORDER BY patient_id, visit_date",
