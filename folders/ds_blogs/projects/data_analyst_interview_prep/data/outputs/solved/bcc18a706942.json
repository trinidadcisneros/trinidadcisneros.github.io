    "hints": [
      "You need to compare each visit to the previous visit for the same patient.",
      "Use a window function that looks at the previous row within each patient's partition, ordered by visit date.",
      "LAG(visit_date) OVER (PARTITION BY patient_id ORDER BY visit_date) gives you the prior visit date; subtract it from the current visit_date to get the day difference."
    ],
    "answer_key": "SELECT patient_id, visit_date, visit_type, visit_date - LAG(visit_date) OVER (PARTITION BY patient_id ORDER BY visit_date) AS days_since_last_visit FROM patient_visits ORDER BY patient_id, visit_date;",
