  "user_solution": "/* notes */\n\nSELECT\n    customer_id,\n    order_date,\n    total_amount,\n    COALESCE(SUM(total_amount) OVER (PARTITION BY customer_id ORDER BY order_date),0) AS cumulative_spent\nFROM grocery_orders\nORDER BY customer_id, order_date;",
