    ],
    "answer_key": "SELECT customer_id, order_date, total_amount, SUM(COALESCE(total_amount, 0)) OVER (PARTITION BY customer_id ORDER BY order_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_spent FROM grocery_orders ORDER BY customer_id, order_date;",
