      "composite_moves": [
        "reshape: unpivot three duration columns into long format using UNION ALL of three SELECT branches, each with a literal phase_name label; output row count is 3x input row count"
      ]
    },
    "hints": [
      "PostgreSQL does not have a native UNPIVOT keyword; use UNION ALL to combine results from multiple SELECT statements.",
      "Write three separate SELECT statements, one for each duration column, and give each a literal phase_name string using AS.",
      "Combine the three SELECTs with UNION ALL, then order the combined result by job_id and phase_name."
    ],
    "answer_key": "SELECT job_id, run_timestamp, 'initialization' AS phase_name, init_duration_sec AS duration_sec FROM job_execution_summary UNION ALL SELECT job_id, run_timestamp, 'processing' AS phase_name, processing_duration_sec AS duration_sec FROM job_execution_summary UNION ALL SELECT job_id, run_timestamp, 'finalization' AS phase_name, finalization_duration_sec AS duration_sec FROM job_execution_summary ORDER BY job_id ASC, phase_name ASC;",
