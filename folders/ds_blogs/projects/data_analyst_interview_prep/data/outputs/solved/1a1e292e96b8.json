  "user_solution": "/* notes */\n\nDO $$\nBEGIN\n\n    UPDATE stories\n    SET performance_tier = 'viral'\n    WHERE view_count >= 10000;\n\n    UPDATE stories\n    SET performance_tier = 'popular'\n    WHERE view_count >= 5000 AND view_count < 10000;\n\n    UPDATE stories\n    SET performance_tier = 'standard'\n    WHERE view_count < 5000;\n\n    UPDATE stories\n    SET engagement_bonus = (like_count + share_count * 2) * 0.10\n    WHERE performance_tier = 'viral';\n\nEND $$;\n\n\n\nSELECT * FROM stories ORDER BY story_id;",
