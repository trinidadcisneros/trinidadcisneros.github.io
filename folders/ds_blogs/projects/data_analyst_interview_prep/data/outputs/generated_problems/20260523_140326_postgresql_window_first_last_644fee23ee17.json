  "hints": [
    "Window functions allow you to access other rows in the same partition without a self-join.",
    "FIRST_VALUE with the default frame works fine, but LAST_VALUE requires an explicit frame extending to the end of the partition.",
    "Use FIRST_VALUE(lesson_title) and LAST_VALUE(lesson_title) OVER (PARTITION BY streak_id ORDER BY completion_date ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)."
  ],
  "answer_key": "SELECT lesson_id, user_id, streak_id, completion_date, lesson_title, FIRST_VALUE(lesson_title) OVER (PARTITION BY streak_id ORDER BY completion_date) AS first_lesson_in_streak, LAST_VALUE(lesson_title) OVER (PARTITION BY streak_id ORDER BY completion_date ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS last_lesson_in_streak FROM streak_lessons ORDER BY user_id, streak_id, completion_date;",
