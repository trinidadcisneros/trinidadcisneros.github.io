{
  "title": "Remove Duplicate Refill Records per Patient",
  "prompt": "The `refill_records` table tracks prescription refill events, but data import errors have created duplicate entries for some patients on the same date and medication. Each duplicate set should be reduced to a single record, keeping the entry with the EARLIEST `created_at` timestamp (the original entry). If multiple duplicates share the same `created_at` time, keep the one with the lowest `record_id`. Write a DELETE statement that removes all duplicate records, then follow it with `SELECT * FROM refill_records ORDER BY record_id;` to show the surviving rows. A duplicate is defined by the combination of (`patient_id`, `medication_code`, `refill_date`)\u2014any rows sharing all three values are duplicates. Your solution must leave single-occurrence records untouched and ensure exactly one survivor per duplicate key.",
  "schema_ddl": "CREATE TABLE refill_records (record_id SERIAL PRIMARY KEY, patient_id INTEGER NOT NULL, medication_code VARCHAR(20) NOT NULL, refill_date DATE NOT NULL, days_supply INTEGER NOT NULL, created_at TIMESTAMP NOT NULL);",
