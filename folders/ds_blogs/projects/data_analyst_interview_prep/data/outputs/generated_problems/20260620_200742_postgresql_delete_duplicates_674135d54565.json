  "hints": [
    "Consider how you can assign a unique rank to each row within groups that share the same patient, medication, and refill date.",
    "Use ROW_NUMBER() with PARTITION BY on the columns that define a duplicate and ORDER BY the criteria that determines which row to keep (earliest created_at, then lowest record_id).",
    "Write a CTE that assigns row numbers, then DELETE from the original table WHERE record_id is in the set of IDs that have row number greater than 1."
  ],
  "answer_key": "WITH ranked AS (SELECT record_id, ROW_NUMBER() OVER (PARTITION BY patient_id, medication_code, refill_date ORDER BY created_at, record_id) AS rn FROM refill_records) DELETE FROM refill_records WHERE record_id IN (SELECT record_id FROM ranked WHERE rn > 1); SELECT * FROM refill_records ORDER BY record_id;",
