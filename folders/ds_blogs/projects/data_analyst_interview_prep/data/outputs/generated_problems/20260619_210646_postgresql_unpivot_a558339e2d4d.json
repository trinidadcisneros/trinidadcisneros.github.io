  "hints": [
    "PostgreSQL does not have a native UNPIVOT keyword; you need to construct the long-format rows manually.",
    "Use UNION ALL to combine six SELECT statements, each pulling one of the wide columns with its corresponding label string ('Q1_Equity', 'Q1_Bonds', etc.).",
    "In each UNION ALL branch, add a WHERE clause to filter out NULL values from that specific source column, then order the final result by portfolio_id and quarter_asset."
  ],
  "answer_key": "SELECT portfolio_id, 'Q1_Bonds' AS quarter_asset, q1_bonds_pct AS allocation_pct FROM quarterly_allocations WHERE q1_bonds_pct IS NOT NULL UNION ALL SELECT portfolio_id, 'Q1_Cash' AS quarter_asset, q1_cash_pct AS allocation_pct FROM quarterly_allocations WHERE q1_cash_pct IS NOT NULL UNION ALL SELECT portfolio_id, 'Q1_Equity' AS quarter_asset, q1_equity_pct AS allocation_pct FROM quarterly_allocations WHERE q1_equity_pct IS NOT NULL UNION ALL SELECT portfolio_id, 'Q2_Bonds' AS quarter_asset, q2_bonds_pct AS allocation_pct FROM quarterly_allocations WHERE q2_bonds_pct IS NOT NULL UNION ALL SELECT portfolio_id, 'Q2_Cash' AS quarter_asset, q2_cash_pct AS allocation_pct FROM quarterly_allocations WHERE q2_cash_pct IS NOT NULL UNION ALL SELECT portfolio_id, 'Q2_Equity' AS quarter_asset, q2_equity_pct AS allocation_pct FROM quarterly_allocations WHERE q2_equity_pct IS NOT NULL ORDER BY portfolio_id ASC, quarter_asset ASC;",
