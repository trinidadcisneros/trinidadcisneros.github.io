  "answer_key": "UPDATE approvals SET fraud_flag = CASE WHEN risk_score >= 80 THEN TRUE WHEN risk_score < 50 THEN FALSE ELSE fraud_flag END;\n\nSELECT * FROM approvals ORDER BY transaction_id;",
