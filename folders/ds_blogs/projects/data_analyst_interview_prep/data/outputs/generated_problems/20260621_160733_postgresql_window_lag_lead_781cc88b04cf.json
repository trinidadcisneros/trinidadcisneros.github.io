  "hints": [
    "You need to look at each user's previous sleep session in chronological order.",
    "Window functions can access values from previous rows when you specify the right PARTITION BY and ORDER BY clauses.",
    "Use LAG(sleep_score) OVER (PARTITION BY user_id ORDER BY sleep_date) to get the previous night's score, then subtract it from the current sleep_score."
  ],
  "answer_key": "SELECT\n  user_id,\n  sleep_date,\n  sleep_score,\n  sleep_score - LAG(sleep_score) OVER (PARTITION BY user_id ORDER BY sleep_date) AS score_change\nFROM sleep_sessions\nWHERE sleep_score IS NOT NULL\nORDER BY user_id, sleep_date;",
