  "hints": [
    "Think about how to count redemptions cumulatively within each tier as you move through time.",
    "Use a window function with PARTITION BY to separate each tier, and ORDER BY to establish the chronological sequence.",
    "COUNT(*) OVER (PARTITION BY member_tier ORDER BY redemption_date, redemption_id) will give you a running count that resets for each tier."
  ],
  "answer_key": "SELECT redemption_id, member_id, member_tier, redemption_date, points_redeemed, COUNT(*) OVER (PARTITION BY member_tier ORDER BY redemption_date, redemption_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_redemptions_in_tier FROM loyalty_redemptions ORDER BY member_tier, redemption_date, redemption_id;",
