  "classification": {
    "input_arrival": "single_table",
    "output_shape": "same_rows",
    "recipe": "time-window",
    "composite_moves": [
      "generate date spine for 2024-01-01 to 2024-01-10 using generate_series",
      "cross join spine with distinct sku list",
      "for each (sku, date) pair, find most recent price on or before that date using correlated subquery ORDER BY effective_date DESC LIMIT 1",
      "preserve NULL when no history exists before the date",
      "order final output by sku, date"
    ]
  },
  "hints": [
    "You need to generate all dates in the range first, then for each date find the price that was in effect.",
    "Use generate_series to create a date spine from 2024-01-01 to 2024-01-10, then cross join with distinct SKUs.",
    "For each (SKU, date) pair, use a correlated subquery with ORDER BY effective_date DESC and LIMIT 1 to find the most recent price on or before that date. The subquery should filter WHERE effective_date <= spine.date."
  ],
  "answer_key": "WITH date_spine AS (\n  SELECT generate_series(\n    DATE '2024-01-01',\n    DATE '2024-01-10',\n    INTERVAL '1 day'\n  )::DATE AS date\n),\nskus AS (\n  SELECT DISTINCT sku FROM kit_pricing\n),\nspine AS (\n  SELECT s.sku, d.date\n  FROM skus s\n  CROSS JOIN date_spine d\n)\nSELECT\n  spine.sku,\n  spine.date,\n  (\n    SELECT kp.price\n    FROM kit_pricing kp\n    WHERE kp.sku = spine.sku\n      AND kp.effective_date <= spine.date\n    ORDER BY kp.effective_date DESC\n    LIMIT 1\n  ) AS price_in_effect\nFROM spine\nORDER BY spine.sku, spine.date;",
