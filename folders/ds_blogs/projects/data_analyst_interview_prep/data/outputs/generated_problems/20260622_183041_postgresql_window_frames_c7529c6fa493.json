  ],
  "answer_key": "SELECT user_id, story_id, posted_at, views, ROUND(AVG(views) OVER (PARTITION BY user_id ORDER BY posted_at ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), 2) AS centered_avg_views FROM stories ORDER BY user_id, posted_at;",
