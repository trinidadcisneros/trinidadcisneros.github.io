  "classification": {
    "input_arrival": "single_table",
    "output_shape": "same_rows",
    "recipe": "row-compare",
    "composite_moves": [
      "window LAG OVER (PARTITION BY claim_id ORDER BY updated_at) to get prior timestamp",
      "EXTRACT(EPOCH ...) / 3600 to compute hours difference",
      "COALESCE to replace NULL (first row per claim) with 0",
      "ROUND to 2 decimal places"
    ]
  },
  "hints": [
    "Consider how you would compare each row to the previous row within the same claim.",
    "Use LAG() to retrieve the prior `updated_at` timestamp for each claim, partitioned by `claim_id` and ordered by `updated_at`.",
    "Calculate the time difference using EXTRACT(EPOCH FROM ...) to get seconds, then divide by 3600 for hours. Handle the first status update of each claim by replacing NULL with 0 using COALESCE."
  ],
  "answer_key": "SELECT\n  claim_id,\n  status,\n  updated_at,\n  ROUND(\n    COALESCE(\n      EXTRACT(EPOCH FROM (updated_at - LAG(updated_at) OVER (PARTITION BY claim_id ORDER BY updated_at))) / 3600,\n      0\n    )::numeric,\n    2\n  ) AS hours_since_prior_status\nFROM claim_status_history\nORDER BY claim_id, updated_at;",
