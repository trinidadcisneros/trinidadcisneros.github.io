  "hints": [
    "You need to create a complete grid of all (course_id, date) combinations first, then attach the watch data.",
    "Use generate_series with DATE literals '2024-03-01' and '2024-03-14' and INTERVAL '1 day' to build the date spine. CROSS JOIN this spine with the courses table.",
    "LEFT JOIN the video_watches table on both course_id and watch_date, then GROUP BY course_id and date. Use COALESCE(SUM(minutes_watched), 0) to turn NULLs into zeros."
  ],
  "answer_key": "WITH date_spine AS (SELECT generate_series(DATE '2024-03-01', DATE '2024-03-14', INTERVAL '1 day') AS watch_date), course_dates AS (SELECT c.course_id, d.watch_date FROM courses c CROSS JOIN date_spine d) SELECT cd.course_id, cd.watch_date, COALESCE(SUM(vw.minutes_watched), 0) AS total_minutes_watched FROM course_dates cd LEFT JOIN video_watches vw ON cd.course_id = vw.course_id AND cd.watch_date = vw.watch_date GROUP BY cd.course_id, cd.watch_date ORDER BY cd.course_id, cd.watch_date;",
