  "classification": {
    "input_arrival": "single_table",
    "output_shape": "same_rows",
    "recipe": "time-window",
    "composite_moves": [
      "generate date spine for range '2024-03-01' to '2024-03-10'",
      "cross join spine with distinct student_ids from history",
      "for each (student, date) pair, find most recent difficulty_level on or before that date using correlated subquery with ORDER BY effective_date DESC LIMIT 1",
      "order by student_id, report_date"
    ]
  },
  "hints": [
    "You need every combination of student and every day in the range; consider a date spine and a cross join with distinct students.",
    "For each (student, day) pair, look up the most recent history row where effective_date is on or before that day using a correlated subquery with ORDER BY and LIMIT 1.",
    "Use generate_series(DATE '2024-03-01', DATE '2024-03-10', INTERVAL '1 day') to build the date spine, cross join it with SELECT DISTINCT student_id FROM student_difficulty_history, then SELECT ... FROM (subquery) WHERE effective_date <= spine.report_date ORDER BY effective_date DESC LIMIT 1."
  ],
  "answer_key": "WITH date_spine AS (SELECT generate_series(DATE '2024-03-01', DATE '2024-03-10', INTERVAL '1 day')::DATE AS report_date), students AS (SELECT DISTINCT student_id FROM student_difficulty_history) SELECT s.student_id, ds.report_date, (SELECT h.difficulty_level FROM student_difficulty_history h WHERE h.student_id = s.student_id AND h.effective_date <= ds.report_date ORDER BY h.effective_date DESC LIMIT 1) AS difficulty_level FROM students s CROSS JOIN date_spine ds ORDER BY s.student_id, ds.report_date;",
