{
  "title": "Student Difficulty Level Fill-Forward Report",
  "prompt": "A K-12 homework app tracks each student's difficulty level preference over time in a single history table. Each row records the student_id, the difficulty_level they selected, and the effective_date when that preference took effect. Generate a daily report for the date range '2024-03-01' through '2024-03-10' (inclusive) that shows every student and every day in that range, with the difficulty level IN EFFECT on that day. If a student has no history row on or before a given day, show NULL for that day. If a student's most recent preference before a day remains in effect (no new row on that exact day), fill forward that value. The output must have columns student_id, report_date, difficulty_level and be ordered by student_id, report_date.",
  "schema_ddl": "CREATE TABLE student_difficulty_history (student_id INT NOT NULL, difficulty_level VARCHAR(20) NOT NULL, effective_date DATE NOT NULL);",
