{
  "title": "Portfolio Allocation As-Of Daily Spine",
  "prompt": "You are building a compliance dashboard for a robo advisor platform. The `allocation_history` table records when a portfolio's target equity allocation changes (as a percentage), stamped with an `effective_date`. Management needs a daily report showing the equity allocation IN EFFECT on each day of March 2024, even on days when no rebalancing event occurred. For any day before the portfolio's first recorded allocation, return NULL for that portfolio. Write a query that outputs one row per (portfolio_id, report_date) pair for every day from '2024-03-01' through '2024-03-31' inclusive, with the `equity_pct` value that was in effect on that date. If multiple allocation records exist on or before a given date, use the most recent one. Order the output by portfolio_id, then report_date.",
  "schema_ddl": "CREATE TABLE allocation_history (portfolio_id INTEGER NOT NULL, effective_date TEXT NOT NULL, equity_pct NUMERIC(5,2) NOT NULL);",
  "example_input_data": "INSERT INTO allocation_history (portfolio_id, effective_date, equity_pct) VALUES (101, '2024-02-28', 60.00), (101, '2024-03-05', 65.00), (101, '2024-03-20', 70.00), (102, '2024-03-10', 55.00), (102, '2024-04-01', 50.00), (103, '2024-03-15', 80.00), (104, '2024-04-05', 45.00);",
  "example_output_columns": [
    "portfolio_id",
    "report_date",
    "equity_pct"
  ],
