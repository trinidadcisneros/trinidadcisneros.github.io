  "classification": {
    "input_arrival": "single_table",
    "output_shape": "same_rows",
    "recipe": "time-window",
    "composite_moves": [
      "generate date spine (generate_series for Mar 2024)",
      "cross join with distinct portfolio IDs",
      "lateral subquery: as-of lookup (ORDER BY effective_date DESC LIMIT 1 WHERE effective_date::date <= spine date)",
      "filter date guard in lateral join",
      "order final by portfolio_id, report_date"
    ]
  },
  "hints": [
    "You need to produce a row for every day in March 2024, for every portfolio that appears in the history table.",
    "Use generate_series to create a date spine from '2024-03-01' to '2024-03-31', cross join it with the distinct portfolio IDs, then for each (portfolio, date) pair find the most recent allocation on or before that date.",
    "A LATERAL subquery with ORDER BY effective_date DESC LIMIT 1 and a WHERE clause filtering effective_date <= the spine date will give you the as-of value. Remember to cast the effective_date column to date type before comparing."
  ],
  "answer_key": "WITH date_spine AS (\n  SELECT generate_series(DATE '2024-03-01', DATE '2024-03-31', INTERVAL '1 day')::date AS report_date\n),\nportfolios AS (\n  SELECT DISTINCT portfolio_id FROM allocation_history\n),\nspine AS (\n  SELECT p.portfolio_id, d.report_date\n  FROM portfolios p\n  CROSS JOIN date_spine d\n)\nSELECT\n  s.portfolio_id,\n  s.report_date,\n  (\n    SELECT ah.equity_pct\n    FROM allocation_history ah\n    WHERE ah.portfolio_id = s.portfolio_id\n      AND ah.effective_date::date <= s.report_date\n    ORDER BY ah.effective_date::date DESC\n    LIMIT 1\n  ) AS equity_pct\nFROM spine s\nORDER BY s.portfolio_id, s.report_date;",
