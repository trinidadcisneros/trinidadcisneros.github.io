  "classification": {
    "input_arrival": "single_table",
    "output_shape": "same_rows",
    "recipe": "time-window",
    "composite_moves": [
      "compute view_rate as views / NULLIF(impressions, 0)",
      "window AVG(view_rate) OVER (PARTITION BY creator_id ORDER BY created_at ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as cumulative_avg_view_rate"
    ]
  },
  "hints": [
    "You'll need to calculate the view rate for each story first, handling the case where impressions might be zero.",
    "Use a window function with PARTITION BY creator_id and ORDER BY created_at to compute the cumulative average. The frame should include all rows from the start of each creator's partition up to the current row.",
    "AVG automatically ignores NULL values, so stories with zero impressions (NULL view rates) won't affect the cumulative average. Use ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW or the shorthand syntax that defaults to this frame when ORDER BY is present."
  ],
  "answer_key": "SELECT creator_id, created_at, title, CASE WHEN impressions = 0 THEN NULL ELSE ROUND((views::DECIMAL / impressions), 2) END AS view_rate, ROUND(AVG(CASE WHEN impressions = 0 THEN NULL ELSE (views::DECIMAL / impressions) END) OVER (PARTITION BY creator_id ORDER BY created_at ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 2) AS cumulative_avg_view_rate FROM stories ORDER BY creator_id, created_at;",
