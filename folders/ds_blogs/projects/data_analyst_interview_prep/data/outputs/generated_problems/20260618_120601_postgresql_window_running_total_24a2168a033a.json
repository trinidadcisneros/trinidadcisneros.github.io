  "hints": [
    "You need to compute a running total that resets for each provider.",
    "Use a window function with PARTITION BY to separate each provider's visits, and ORDER BY to accumulate chronologically.",
    "The frame should be UNBOUNDED PRECEDING (or the default for ORDER BY with SUM OVER) so each row includes all prior rows in its partition."
  ],
  "answer_key": "SELECT provider_id, DATE(completion_timestamp) AS completion_date, SUM(1) OVER (PARTITION BY provider_id ORDER BY completion_timestamp ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_completed FROM visits WHERE completion_timestamp IS NOT NULL ORDER BY provider_id, completion_timestamp;",
