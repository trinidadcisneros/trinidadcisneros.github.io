  "answer_key": "WITH combined AS (\n  SELECT order_id, process_date AS d, 'processing' AS status\n  FROM processing_orders\n  WHERE process_date BETWEEN '2024-01-01' AND '2024-01-31'\n  UNION ALL\n  SELECT order_id, ship_date AS d, 'shipped' AS status\n  FROM shipped_orders\n  WHERE ship_date BETWEEN '2024-01-01' AND '2024-01-31'\n),\nranked AS (\n  SELECT\n    order_id,\n    status,\n    d,\n    d - (ROW_NUMBER() OVER (PARTITION BY order_id, status ORDER BY d))::INT AS grp\n  FROM combined\n)\nSELECT\n  order_id,\n  status,\n  MIN(d) AS start_date,\n  MAX(d) AS end_date\nFROM ranked\nGROUP BY order_id, status, grp\nORDER BY start_date;",
