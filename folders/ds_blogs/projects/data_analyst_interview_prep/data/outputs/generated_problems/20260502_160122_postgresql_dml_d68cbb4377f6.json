  "answer_key": "INSERT INTO appointments_archive (appointment_id, patient_id, provider_id, scheduled_date, actual_start_time, actual_end_time, session_duration_minutes, archived_at)\nSELECT appointment_id, patient_id, provider_id, scheduled_date, actual_start_time, actual_end_time, CAST(EXTRACT(EPOCH FROM (actual_end_time - actual_start_time)) / 60 AS INTEGER), CURRENT_TIMESTAMP\nFROM appointments\nWHERE status = 'completed' AND actual_start_time IS NOT NULL AND actual_end_time IS NOT NULL;\n\nSELECT * FROM appointments_archive ORDER BY appointment_id;",
