{
  "title": "Archive Completed Telehealth Appointments",
  "prompt": "You are managing a telehealth platform's data retention workflow. The `appointments` table holds all scheduled appointments. The `appointments_archive` table stores historical records of completed sessions. Write a single INSERT statement that copies all appointments with status 'completed' from `appointments` into `appointments_archive`, transforming the data as follows: calculate `session_duration_minutes` as the difference between `actual_end_time` and `actual_start_time` in minutes (use EXTRACT(EPOCH FROM ...) / 60 and cast to INTEGER), set `archived_at` to the current timestamp, and copy `appointment_id`, `patient_id`, `provider_id`, `scheduled_date`, `actual_start_time`, and `actual_end_time`. Only archive appointments where both `actual_start_time` and `actual_end_time` are NOT NULL. After the INSERT, write a SELECT statement that retrieves all rows from `appointments_archive` ordered by `appointment_id` to confirm the result.",
  "schema_ddl": "CREATE TABLE appointments (appointment_id INTEGER PRIMARY KEY, patient_id INTEGER NOT NULL, provider_id INTEGER NOT NULL, scheduled_date DATE NOT NULL, status VARCHAR(20) NOT NULL, actual_start_time TIMESTAMP, actual_end_time TIMESTAMP); CREATE TABLE appointments_archive (appointment_id INTEGER PRIMARY KEY, patient_id INTEGER NOT NULL, provider_id INTEGER NOT NULL, scheduled_date DATE NOT NULL, actual_start_time TIMESTAMP NOT NULL, actual_end_time TIMESTAMP NOT NULL, session_duration_minutes INTEGER NOT NULL, archived_at TIMESTAMP NOT NULL);",
