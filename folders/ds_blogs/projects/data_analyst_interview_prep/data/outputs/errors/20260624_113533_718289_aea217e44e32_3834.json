  "title": "Clean and Parse Customer Email Domains",
  "prompt": "Your marketing team imported a customer signup list from an external vendor, but the email addresses are inconsistently formatted with leading/trailing whitespace and mixed case. Write a query against the `cart_signups` table that extracts and cleans each customer's email username and domain. Return four columns: `customer_id`, `clean_email` (trimmed and lowercased), `username` (the part before the @), and `domain` (the part after the @, capitalized with INITCAP). Include only customers whose `signup_completed` flag is true. Order the results by `customer_id` ascending.",
  "schema_ddl": "CREATE TABLE cart_signups (\n  customer_id INT PRIMARY KEY,\n  raw_email VARCHAR(200),\n  signup_completed VARCHAR(10),\n  added_items INT,\n  signup_date VARCHAR(20)\n);",
  "answer_key": "SELECT\n  customer_id,\n  LOWER(TRIM(raw_email)) AS clean_email,\n  SPLIT_PART(TRIM(raw_email), '@', 1) AS username,\n  INITCAP(SPLIT_PART(TRIM(raw_email), '@', 2)) AS domain\nFROM cart_signups\nWHERE signup_completed::boolean = true\nORDER BY customer_id;",
