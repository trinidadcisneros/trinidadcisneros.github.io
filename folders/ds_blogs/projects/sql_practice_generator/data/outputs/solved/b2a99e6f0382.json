  "user_solution": "/* notes */\n\nSELECT\n    patient_id,\n    visit_id,\n    visit_completed_at,\n    FLOOR(\n        EXTRACT(EPOCH FROM (\n            visit_completed_at\n              - LAG(visit_completed_at) OVER (\n                    PARTITION BY patient_id ORDER BY visit_completed_at\n                    ) \n        )) / 86400 )::int AS days_since_previous_visit\nFROM telehealth_visits\nWHERE visit_completed_at IS NOT NULL\nORDER BY patient_id, visit_completed_at;",
  "solved_at": "2026-05-24T19:12:15.857371"
