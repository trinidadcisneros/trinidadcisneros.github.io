    "hints": [
      "You need to compare each visit to the previous visit for the same patient.",
      "Use a window function with LAG() partitioned by patient and ordered by completion time.",
      "Calculate the difference in days between the current visit_completed_at and the LAG result; handle NULL for the first visit in each partition."
    ],
    "answer_key": "SELECT patient_id, visit_id, visit_completed_at, EXTRACT(DAY FROM (visit_completed_at - LAG(visit_completed_at) OVER (PARTITION BY patient_id ORDER BY visit_completed_at)))::INT AS days_since_previous_visit FROM telehealth_visits WHERE status = 'completed' ORDER BY patient_id, visit_completed_at;",
