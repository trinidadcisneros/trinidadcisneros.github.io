    "answer_key": "DELETE FROM transaction_queue\nWHERE queue_id NOT IN (\n  SELECT MIN(queue_id)\n  FROM transaction_queue AS t2\n  WHERE t2.user_id = transaction_queue.user_id\n    AND t2.merchant_id = transaction_queue.merchant_id\n    AND t2.amount = transaction_queue.amount\n  GROUP BY t2.user_id, t2.merchant_id, t2.amount\n);\n\nSELECT * FROM transaction_queue ORDER BY queue_id;",
