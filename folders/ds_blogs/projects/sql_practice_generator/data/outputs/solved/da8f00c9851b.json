  "user_solution": "-- WE NEED TO DELETE THOSE WHERE ITS TRUE\nDELETE\n  FROM transaction_queue\n WHERE queue_id IN (\n        SELECT DISTINCT queue_id\n          FROM (\n                SELECT queue_id,\n                       ROW_NUMBER() OVER (PARTITION BY user_id, merchant_id, amount ORDER BY queue_id) AS rn\n                  FROM transaction_queue\n               )\n         WHERE rn > 1\n       );\n\n\nSELECT *\n  FROM transaction_queue\n ORDER BY queue_id;",
