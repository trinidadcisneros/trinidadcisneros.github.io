    "hints": [
      "You need to compare each row to the previous row within the same user's sequence of updates.",
      "Window functions with LAG can access the previous row's timestamp when partitioned by user and ordered by timestamp.",
      "Use EXTRACT(DAY FROM ...) or date subtraction to convert the timestamp difference into days, and handle the NULL case for the first update per user."
    ],
    "answer_key": "SELECT user_id, update_timestamp, EXTRACT(DAY FROM (update_timestamp - LAG(update_timestamp) OVER (PARTITION BY user_id ORDER BY update_timestamp))) AS days_since_previous_update FROM profile_updates ORDER BY user_id, update_timestamp;",
