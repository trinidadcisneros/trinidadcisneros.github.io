  "user_solution": "/*\n1. create lag date\n2. calculate difference\n3. provide final table\n */\n\nWITH base AS (\n    SELECT\n        user_id,\n        update_timestamp,\n        LAG(update_timestamp) OVER (PARTITION BY user_id ORDER BY update_timestamp) AS prev_date\n    FROM profile_updates\n),\ndate_dff AS (\n    SELECT\n        *,\n        EXTRACT(DAY FROM (update_timestamp - prev_date)) AS days_since_previous_update\n    FROM base\n\n)\nSELECT\n    user_id,\n    update_timestamp,\n    days_since_previous_update\nFROM date_dff;\n",
