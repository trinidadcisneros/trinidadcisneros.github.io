  "hints": [
    "Think about how you can track a running total for each player separately.",
    "Use a window function with PARTITION BY player_id and ORDER BY invited_at to compute cumulative metrics.",
    "SUM the accepted flag as an integer over the player's invitation timeline to get the cumulative acceptances: SUM(CASE WHEN accepted THEN 1 ELSE 0 END) OVER (PARTITION BY player_id ORDER BY invited_at)."
  ],
  "answer_key": "SELECT player_id, invited_at, accepted, SUM(CASE WHEN accepted THEN 1 ELSE 0 END) OVER (PARTITION BY player_id ORDER BY invited_at ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_acceptances FROM match_invitations ORDER BY player_id, invited_at;",
