  "hints": [
    "You'll need to compute the time difference between two timestamp columns and convert it to hours.",
    "Use PERCENT_RANK() ordered by turnaround time ascending (fastest first) to find the top 25%. Remember that PERCENT_RANK returns 0 for the best row when ordering ASC.",
    "Filter where PERCENT_RANK() <= 0.25. Use ROUND(PERCENT_RANK()::numeric, 4) to format the rank value. Don't forget to exclude kits where result_released_at is NULL."
  ],
  "answer_key": "WITH kit_turnaround AS (SELECT kit_id, patient_email, EXTRACT(EPOCH FROM (result_released_at - shipped_at)) / 3600 AS turnaround_hours FROM diagnostic_kits WHERE result_released_at IS NOT NULL), ranked_kits AS (SELECT kit_id, patient_email, turnaround_hours, PERCENT_RANK() OVER (ORDER BY turnaround_hours ASC) AS pct_rank FROM kit_turnaround) SELECT kit_id, patient_email, ROUND(turnaround_hours::numeric, 4) AS turnaround_hours, ROUND(pct_rank::numeric, 4) AS percent_rank_value FROM ranked_kits WHERE pct_rank <= 0.25 ORDER BY turnaround_hours ASC, kit_id ASC;",
