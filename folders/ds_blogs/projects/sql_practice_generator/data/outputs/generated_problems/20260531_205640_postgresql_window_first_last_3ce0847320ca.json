  "hints": [
    "Window functions can retrieve values from other rows in the same partition without collapsing the result set.",
    "FIRST_VALUE and LAST_VALUE require careful attention to the frame clause; the default frame for LAST_VALUE may not give you the partition's final row.",
    "Use FIRST_VALUE(refill_date) OVER (PARTITION BY patient_id ORDER BY refill_date ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) to get the earliest refill date per patient, and similarly for LAST_VALUE with the same explicit frame to get the latest."
  ],
  "answer_key": "SELECT patient_id, prescription_id, refill_date, FIRST_VALUE(refill_date) OVER (PARTITION BY patient_id ORDER BY refill_date ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS first_refill_date, LAST_VALUE(refill_date) OVER (PARTITION BY patient_id ORDER BY refill_date ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS last_refill_date FROM refill_events ORDER BY patient_id, refill_date;",
