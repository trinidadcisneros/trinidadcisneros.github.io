{
  "title": "Track Student Grade Improvement Between Attempts",
  "prompt": "Write a query that shows each student's grade improvement between consecutive assignment attempts. For each submission in the `submissions` table, calculate the difference between the current score and the previous score for the same student on the same assignment. Students can submit multiple attempts for an assignment, and you should compare each attempt to the immediately prior attempt (ordered by `submitted_at`). If a submission is the student's first attempt on that assignment, the improvement should be NULL. Return columns: `student_id`, `assignment_id`, `submitted_at`, `score`, and `score_improvement` (the current score minus the previous score). Order results by `student_id`, `assignment_id`, and `submitted_at`.",
  "schema_ddl": "CREATE TABLE submissions (\n  submission_id SERIAL PRIMARY KEY,\n  student_id INTEGER NOT NULL,\n  assignment_id INTEGER NOT NULL,\n  submitted_at TIMESTAMP NOT NULL,\n  score DECIMAL(5,2) NOT NULL\n);",
