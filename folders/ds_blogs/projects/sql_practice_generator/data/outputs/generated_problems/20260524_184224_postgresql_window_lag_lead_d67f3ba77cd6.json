  "hints": [
    "You need to compare each submission to the previous submission for the same student and assignment.",
    "Use a window function that can look at the prior row within a partition defined by student and assignment, ordered by submission time.",
    "LAG() will return NULL for the first row in each partition; keep those NULLs in your score_improvement column."
  ],
  "answer_key": "SELECT\n  student_id,\n  assignment_id,\n  submitted_at,\n  score,\n  score - LAG(score) OVER (PARTITION BY student_id, assignment_id ORDER BY submitted_at) AS score_improvement\nFROM submissions\nORDER BY student_id, assignment_id, submitted_at;",
