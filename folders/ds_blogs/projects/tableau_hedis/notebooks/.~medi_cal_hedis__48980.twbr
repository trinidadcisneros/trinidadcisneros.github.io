    <worksheet name='LA Care Ranks Mid Pack on Quality Among California&apos;s Medi-Cal Plans2023 quality score by plan and region; LA Care in orange, red line marks the average'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000'>LA Care Held Its Quality Since 2016 While Its County Rival Fell Nearly 10 Points </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>Change in yearly quality score from the 2016 baseline, LA Care vs Health Net in Los Angeles</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='aqfs_clean' name='federated.0fwuxsj0i5ubpx19kkzhp136xt4l' />
          </datasources>
          <datasource-dependencies datasource='federated.0fwuxsj0i5ubpx19kkzhp136xt4l'>
            <column caption='Aqfs' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AQFS]' role='measure' type='quantitative' />
            <column datatype='string' name='[Reporting Unit]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Health Net - Los Angeles&quot;' value='Health Net' />
                <alias key='&quot;LA Care - Los Angeles&quot;' value='LA CARE' />
              </aliases>
            </column>
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[AQFS]' derivation='Avg' name='[diff:avg:AQFS:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-2</value>
                </address>
              </table-calc>
            </column-instance>
            <column-instance column='[Reporting Unit]' derivation='None' name='[none:Reporting Unit:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0fwuxsj0i5ubpx19kkzhp136xt4l].[none:Reporting Unit:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Reporting Unit:nk]' member='&quot;Health Net - Los Angeles&quot;' />
              <groupfilter function='member' level='[none:Reporting Unit:nk]' member='&quot;LA Care - Los Angeles&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0fwuxsj0i5ubpx19kkzhp136xt4l].[none:Reporting Unit:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
